###############################################################################
# Discord AI Ticket Responder — environment TEMPLATE
#
#   *** THIS FILE IS COMMITTED TO GIT. ON A PUBLIC REPO, IT IS PUBLIC. ***
#   *** LEAVE EVERY SECRET BELOW EMPTY. FAKE VALUES ONLY, IF ANY. ***
#
# Real credentials go in `.env`, which is git-ignored:
#
#       cp .env.example .env      # then edit .env, never this file
#
# Pasting a live key here publishes it. Deleting the commit afterwards does NOT
# undo that: bots scrape public repos for key patterns within minutes, and
# GitHub keeps orphaned commits reachable by SHA until garbage collection. A
# key that has been committed must be rotated in the provider's console.
#
# Guard rails:
#   python -m scripts.install_hooks   # install the pre-commit secret scanner
#   python -m scripts.secretscan      # scan tracked files on demand
#   python -m scripts.doctor          # pre-flight check, includes leak scan
###############################################################################

# --- Discord (required) -----------------------------------------------------
# Bot token from https://discord.com/developers/applications
# NOTE: you must enable "Message Content Intent" in the Bot settings page,
#       otherwise the ticket listener cannot read member messages.
# Leave empty here. Real token goes in .env only.
DISCORD_BOT_TOKEN=

# --- Database ---------------------------------------------------------------
# Local development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///data/tickets.db
# Production (PostgreSQL / Supabase) — uncomment and install `asyncpg`:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/tickets
# Supabase pooler example:
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- AI providers -----------------------------------------------------------
# Failover order, first available provider wins. Comma separated.
# Valid values: groq, cerebras, gemini
AI_PROVIDER_CHAIN=groq,cerebras,gemini

# Primary — Groq (https://console.groq.com/keys) — 14,400 requests/day free
# Leave empty here. Real key goes in .env only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Free-tier ceilings. Defaults match Groq's published limits per model.
GROQ_REQUESTS_PER_MINUTE=15
GROQ_REQUESTS_PER_DAY=14400

# Primary alt — Cerebras (https://cloud.cerebras.io/) — sub-second inference
# Leave empty here. Real key goes in .env only.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_REQUESTS_PER_MINUTE=60
CEREBRAS_REQUESTS_PER_DAY=14400

# Fallback — Google Gemini (https://aistudio.google.com/apikey)
# Leave empty here. Real key goes in .env only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_DAY=1500

# --- Inference tuning -------------------------------------------------------
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=700
AI_REQUEST_TIMEOUT=25
AI_MAX_RETRIES=3
AI_BACKOFF_BASE=0.6
AI_BACKOFF_CAP=12.0
# Hard ceiling for one end-to-end answer (across retries + failover).
AI_TOTAL_DEADLINE=45

# --- Ticket behaviour -------------------------------------------------------
# How many prior messages are fed to the model as chat memory.
HISTORY_MESSAGE_LIMIT=10
HISTORY_CHAR_BUDGET=6000
# Max characters accepted for a single server knowledge base.
KNOWLEDGE_BASE_CHAR_LIMIT=40000
# Only answer inside the category set by /set-ticket-category (recommended).
# If false, channels whose name matches TICKET_NAME_PATTERN are also served.
REQUIRE_CONFIGURED_CATEGORY=true
TICKET_NAME_PATTERN=^(ticket|support|help)[-_]
# Per-user cooldown between AI answers, in seconds (abuse protection).
USER_COOLDOWN_SECONDS=5
# Max tickets answered in parallel across all servers.
MAX_CONCURRENT_TICKETS=12
# Do not re-ping the staff role in the same ticket more often than this.
ESCALATION_COOLDOWN_SECONDS=900
# Escalate immediately (without spending an API call) on high-risk phrasing.
ESCALATION_PREFLIGHT_SAFETY=true
ESCALATION_PREFLIGHT_REQUESTS=false

# --- Operations -------------------------------------------------------------
LOG_LEVEL=INFO
# Sync slash commands per-guild instantly for these guilds (comma separated IDs).
# Global sync can take up to an hour to propagate.
DEV_GUILD_IDS=
